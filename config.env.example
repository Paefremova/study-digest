# Настройки study. Скопировать в config.env и заполнить под себя — это делает setup.sh.
# Формат: КЛЮЧ=значение, без кавычек. Строки с # игнорируются. Тильда разворачивается.
#
# ВСЁ, включая секреты, лежит в config.env (он в .gitignore и на GitHub не уходит —
# на GitHub только этот пример без значений). Права config.env — 600.
# Токены rutube (refresh/access) инструмент ведёт сам в .digest/.secrets/ (тоже вне git).

# --- Moodle
TUIS_URL=https://esystem.rudn.ru
# Токены-строки (заполнить своими значениями):
TUIS_TOKEN=
GITVERSE_TOKEN=
SOURCECRAFT_TOKEN=
# Rutube (режим token, необязательно; jwt-режим токен не использует):
RUTUBE_TOKEN=
# Глубина окна дедлайнов в сводке, дней
DIGEST_DAYS=21
# Снимок состояния между запусками сводки
DIGEST_STATE=.state.json

# --- Хостинги кода
# Репозиторий берётся из remote текущего git-каталога: origin для GitVerse, src для
# SourceCraft — так одни и те же команды работают для всех курсов, достаточно запускать
# их из каталога нужного репозитория. Эти значения — запасные, когда remote нет.
GV_REPO=
SC_REPO=

# --- Курсы
# Сводка берёт все курсы пользователя из ТУИС и убирает перечисленные в COURSE_IGNORE.
# Настраивает `study courses --setup` (или setup.sh): выбор игнора и имя локальной папки
# на каждый курс — строки CODE <id в Moodle> <имя папки>; при пустом вводе берётся id курса.
DIGEST_ACTIVE_DAYS=60
COURSE_IGNORE=
