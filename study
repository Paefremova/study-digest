#!/usr/bin/env python3
"""Единая точка входа. Код — в src/study/, документация — в README.md и docs/."""
import ctypes
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent / "src"))

from study.cli import main


def windows_console():
    """Windows: вывод в файл или пайп идёт в системной кодировке, а не UTF-8, и консоль
    без VT-режима печатает ANSI-последовательности как есть."""
    for stream in (sys.stdout, sys.stderr):
        stream.reconfigure(encoding="utf-8", errors="replace")
    k = ctypes.windll.kernel32
    handle, mode = k.GetStdHandle(-11), ctypes.c_uint()   # STD_OUTPUT_HANDLE
    if k.GetConsoleMode(handle, ctypes.byref(mode)):
        k.SetConsoleMode(handle, mode.value | 4)         # ENABLE_VIRTUAL_TERMINAL_PROCESSING


if __name__ == "__main__":
    if sys.platform == "win32":
        windows_console()
    sys.exit(main())
